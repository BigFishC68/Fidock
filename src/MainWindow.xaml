<Window x:Class="MyDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MyDock"
        Title="MyDock"
        Icon="pack://application:,,,/MyDock;component/assets/Fidock.ico"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- ============ 统一的深色弹层风格（右键菜单 / 菜单项 / 分隔线） ============ -->
        <Style x:Key="DarkMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 勾选标记列（开机启动等可勾选项） -->
                                <TextBlock x:Name="CheckGlyph" Text="&#x2714;"
                                           Foreground="#E6FFFFFF" FontSize="10"
                                           VerticalAlignment="Center" Visibility="Collapsed"/>
                                <!-- 必须显式绑定 Header 并转发 Foreground，否则文字不渲染 / 变黑字 -->
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                                  Content="{TemplateBinding Header}"
                                                  ContentSource="Header"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkSeparator" TargetType="Separator">
            <!-- 左右 10 = 菜单内边距 6 + 项内边距 4，让横线与图标左缘对齐 -->
            <Setter Property="Margin" Value="10,5,10,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Height="1" Fill="#30FFFFFF" HorizontalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="Background" Value="#F21F1F1F"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="6"
                                SnapsToDevicePixels="True">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 右键菜单只管程序（结束进程 / 打开位置 / 移除）；窗口切换与最小化归左键；固定项在代码里抑制 -->
        <ContextMenu x:Key="DockContextMenu"
                     Style="{StaticResource DarkContextMenu}"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <!-- 图标右键菜单：顺序 移除 → 打开文件位置 → 以管理员身份运行 → 结束进程（后两项按状态出现） -->
            <ContextMenu.Resources>
                <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMenuItem}"/>
                <Style TargetType="Separator" BasedOn="{StaticResource DarkSeparator}"/>
                <!-- 用户项专用：固定项 / 文件夹 / 占位项不显示这两项 -->
                <Style x:Key="UserIconMenuItem" TargetType="MenuItem" BasedOn="{StaticResource DarkMenuItem}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFixed}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContextMenu.Resources>
            <MenuItem Header="移除" Style="{StaticResource UserIconMenuItem}" Click="RemoveApp_Click"/>
            <MenuItem Header="打开文件位置" Style="{StaticResource UserIconMenuItem}" Click="OpenLocation_Click"/>
            <MenuItem Tag="win-admin" Header="以管理员身份运行" Visibility="Collapsed"
                      Click="RunAsAdmin_Click"/>
            <MenuItem Tag="win-kill" Header="结束进程" Visibility="Collapsed"
                      Click="KillProcessMenuItem_Click"/>
        </ContextMenu>

        <Style x:Key="DockIcon" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,1"/>
            <Setter Property="ContextMenu" Value="{StaticResource DockContextMenu}"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             To="1.18" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             To="1.18" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                <Setter Property="Opacity" Value="0.3"/>
            </DataTrigger>
            <!-- 已发出启动请求、进程还没起来：灰显，避免用户以为没点上而连点 -->
            <DataTrigger Binding="{Binding IsStarting}" Value="True">
                <Setter Property="Opacity" Value="0.45"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                <Setter Property="ContextMenu" Value="{x:Null}"/>
            </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 左键多窗口选择面板中的窗口项 -->
        <Style x:Key="WindowListItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,1"/>
            <Style.Triggers>
                <!-- 悬浮/按下都是淡淡变浅（仿 Windows 开始菜单），不压过文字 -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#14FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#20FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 选择面板中单项行尾的关闭按钮（只关这一个窗口） -->
        <Style x:Key="WindowItemClose" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主栏与文件夹面板共用的图标模板 -->
        <DataTemplate x:Key="DockItemTemplate">
            <Button Style="{StaticResource DockIcon}"
                    ToolTip="{Binding ToolTipText}"
                    AllowDrop="True"
                    Click="Icon_Click"
                    ContextMenuOpening="Icon_ContextMenuOpening"
                    PreviewMouseLeftButtonDown="Icon_PreviewMouseLeftButtonDown"
                    PreviewMouseUp="Icon_PreviewMouseUp"
                    DragOver="Icon_DragOver"
                    Drop="Icon_Drop">
                <Grid Width="32" Height="32">
                    <Image Source="{Binding IconImage}"
                           Width="32" Height="32"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- 运行提示小圆点 -->
                    <Ellipse Width="4" Height="4"
                             Fill="#CCFFFFFF"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Bottom"
                             Margin="0,0,0,-6">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- 整个 Dock 栏：固定在底部、不可移动；右键空白处可设置开机启动 / 退出 -->
        <Border x:Name="DockArea"
                CornerRadius="16"
                Padding="10,6"
                AllowDrop="True"
                DragOver="DockArea_DragOver"
                Drop="DockArea_Drop">
            <Border.ContextMenu>
                <ContextMenu Style="{StaticResource DarkContextMenu}">
                    <ContextMenu.Resources>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMenuItem}"/>
                        <Style TargetType="Separator" BasedOn="{StaticResource DarkSeparator}"/>
                    </ContextMenu.Resources>
                    <MenuItem x:Name="AutoStartMenu"
                              Header="开机启动"
                              IsCheckable="True"
                              Checked="AutoStart_Changed"
                              Unchecked="AutoStart_Changed"/>
                    <Separator/>
                    <MenuItem Header="添加程序…" Click="AddApps_Click"/>
                    <MenuItem Header="添加快速访问…" Click="AddQuickAccess_Click"/>
                    <MenuItem Header="批量移除" Click="BatchRemove_Click"/>
                    <MenuItem Header="打开配置文件夹" Click="OpenConfigFolder_Click"/>
                    <Separator/>
                    <MenuItem Header="退出" Click="Close_Click"/>
                </ContextMenu>
            </Border.ContextMenu>

            <!-- 布局：资源管理器 · 文件夹 · | · 用户项 · | · 回收站 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ContentControl Content="{Binding ExplorerApp}"
                                ContentTemplate="{StaticResource DockItemTemplate}"/>
                <ContentControl x:Name="FolderButtonHost"
                                Content="{Binding FolderApp}"
                                ContentTemplate="{StaticResource DockItemTemplate}"/>
                <Rectangle x:Name="FolderSep" Width="1" Height="26" Margin="6,0"/>
                <ItemsControl x:Name="AppItems"
                              ItemsSource="{Binding Apps}"
                              ItemTemplate="{StaticResource DockItemTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Rectangle x:Name="RecycleSep" Width="1" Height="26" Margin="6,0"/>
                <!-- 运行中的文件夹项：临时显示在回收站左侧，关闭后回到文件夹面板 -->
                <ItemsControl x:Name="RunningFolderItems"
                              ItemsSource="{Binding RunningFolderView}"
                              ItemTemplate="{StaticResource DockItemTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ContentControl Content="{Binding RecycleApp}"
                                ContentTemplate="{StaticResource DockItemTemplate}"/>
            </StackPanel>
        </Border>

        <!-- 文件夹上拉面板：拖拽排序、与 Dock 栏互拖、拖文件加入或直接打开 -->
        <Popup x:Name="FolderPopup"
               AllowsTransparency="True"
               StaysOpen="False"
               Placement="Top"
               PopupAnimation="Fade"
               VerticalOffset="-6">
            <Border x:Name="FolderPopupBorder"
                    Background="#E61F1F1F"
                    BorderBrush="#40FFFFFF"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="10"
                    AllowDrop="True"
                    PreviewMouseMove="Window_PreviewMouseMove"
                    PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
                    DragOver="DockArea_DragOver"
                    Drop="FolderPopup_Drop">
                <ItemsControl x:Name="FolderItems"
                              ItemsSource="{Binding FolderPopupView}"
                              ItemTemplate="{StaticResource DockItemTemplate}"
                              MaxWidth="320">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" MaxWidth="300"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Border>
        </Popup>
        <!-- 多窗口选择面板：仅在程序有多个窗口且不在顶层时呼出 -->
        <Popup x:Name="WindowListPopup"
               AllowsTransparency="True"
               StaysOpen="False"
               Placement="Top"
               PopupAnimation="Fade"
               VerticalOffset="-6">
            <Border Background="#E61F1F1F"
                    BorderBrush="#40FFFFFF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="6"
                    MinWidth="180"
                    MaxWidth="320"
                    MaxHeight="420">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding WindowListItems}">
                        <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <!-- 整行：切换到该窗口 -->
                                <Button Style="{StaticResource WindowListItem}"
                                        Click="WindowListItem_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Icon}"
                                               Width="16" Height="16"
                                               Stretch="Uniform"
                                               Margin="0,0,8,0"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                   Foreground="#E6FFFFFF"
                                                   FontSize="12"
                                                   Margin="0,0,28,0"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <!-- 当前前台窗口加粗标识 -->
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Button>
                                <!-- 行尾关闭按钮：悬浮于行上，只关闭这一个窗口 -->
                                <Button Style="{StaticResource WindowItemClose}"
                                        Tag="win-close-item"
                                        HorizontalAlignment="Right"
                                        Click="WindowItemClose_Click"
                                        ToolTip="关闭该窗口">
                                    <TextBlock Text="&#x2715;" FontSize="10" Foreground="#CCFFFFFF"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</Window>
