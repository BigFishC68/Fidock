<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- 程序集标识 / 版本信息 -->
    <AssemblyName>MyDock</AssemblyName>
    <RootNamespace>MyDock</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>MyDock</Product>
    <AssemblyTitle>MyDock 桌面 Dock</AssemblyTitle>
    <Description>仿 macOS 风格的 Windows 桌面 Dock：左键管窗口、右键管程序</Description>
    <NeutralLanguage>zh-Hans</NeutralLanguage>

    <!-- 构建可复现：同样的源码产出同样的二进制 -->
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>

    <!-- 程序图标（多尺寸 16~256） -->
    <ApplicationIcon>assets\Fidock.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 源码统一放在 src/ 下；App.xaml 必须显式声明为 ApplicationDefinition（否则会被当成普通 Page） -->
  <ItemGroup>
    <Page Remove="src\App.xaml" />
    <ApplicationDefinition Include="src\App.xaml" />
  </ItemGroup>

  <!-- 图标同时作为 WPF 资源，供 Window.Icon 使用 -->
  <ItemGroup>
    <Resource Include="assets\Fidock.ico" />
  </ItemGroup>

</Project>
